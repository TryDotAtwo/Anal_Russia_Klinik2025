!reports/llm/llm_gold_40*.json
!reports/llm/openrouter_gold40*.json
!reports/llm/openrouter_all_results*.json

# Input data policy: keep source dictionaries needed for reproducibility unless a file exceeds GitHub limits.
data/input/*.pdf
data/input/*.html
data/input/*_files/
!data/input/README.md
!data/input/.gitkeep
!data/input/*.json

# Large GitHub-blocking JSON inputs.
data/input/clinical_recommendations.json
data/input/drugs.json
